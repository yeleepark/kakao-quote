# 로컬 실행용. 복사해서 .env로 저장 후 값을 채우세요 (.env는 커밋되지 않습니다)
# GitHub Actions에서는 같은 이름을 Repository secrets에 등록합니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 선택: 글귀를 Claude API로 생성 (없으면 CLI → 내장 목록 순으로 대체)
ANTHROPIC_API_KEY=
# 로컬 launchd용: claude 절대경로 (`which claude`)
CLAUDE_BIN=
# 선택: KAKAO_TOKEN_FILE, KAKAO_REDIRECT_URI, QUOTE_MODEL
